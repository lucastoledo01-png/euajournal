# Worker de renderização e publicação do Instagram.
#
# Precisa de Chromium, o que a hospedagem compartilhada não permitia. O
# navegador é instalado na versão exata do playwright declarado no
# package-lock, evitando divergência entre a biblioteca e o binário.

FROM node:22-bookworm-slim

WORKDIR /app

# devDependencies são necessárias: o worker roda via tsx e o pacote playwright
# fornece o instalador do navegador.
COPY package.json package-lock.json ./
RUN npm ci

# --with-deps traz as bibliotecas de sistema que o Chromium exige.
RUN npx playwright install --with-deps chromium \
  && rm -rf /var/lib/apt/lists/*

# Reels (28/10/2026): o ffmpeg corta e compõe o vídeo no molde, e o yt-dlp
# baixa o vídeo do YouTube. O yt-dlp é um binário com versão fixada: o YouTube
# muda e a versão precisa subir junto, então ela é um ARG, não a "latest".
ARG YTDLP_VERSION=2026.10.26
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg ca-certificates curl \
  && curl -fsSL -o /usr/local/bin/yt-dlp \
       "https://github.com/yt-dlp/yt-dlp/releases/download/${YTDLP_VERSION}/yt-dlp_linux" \
  && chmod +x /usr/local/bin/yt-dlp \
  && rm -rf /var/lib/apt/lists/*

COPY tsconfig.json ./
COPY src ./src

ENV NODE_ENV=production
# Sem intervalo o script faz uma passada e encerra; com intervalo ele repete.
ENV WORKER_INTERVAL_SECONDS=900

CMD ["npx", "tsx", "src/scripts/instagram-worker.ts"]
