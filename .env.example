# Copie este arquivo para .env.local e preencha localmente.
# Nunca commitar valores reais.
#
# As variáveis marcadas como OBRIGATÓRIA não têm valor padrão: se faltarem, a
# funcionalidade correspondente falha de forma explícita em vez de assumir um
# valor embutido no código.

# Supabase — OBRIGATÓRIAS para qualquer rota que toque o banco
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Uma das duas abaixo é OBRIGATÓRIA (chave de serviço, somente no servidor)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Acesso ao painel administrativo
# ADMIN_PASSWORD é OBRIGATÓRIA (ADMIN_TEMP_PASSWORD é aceita como alternativa)
ADMIN_PASSWORD=
ADMIN_TEMP_PASSWORD=
# OBRIGATÓRIA — assina o cookie de sessão. Use valor aleatório longo e exclusivo.
ADMIN_SESSION_SECRET=

# OpenAI — OBRIGATÓRIA para o pipeline editorial
# Sem ela a redação falha; não existe modo de contingência gerando conteúdo.
OPENAI_API_KEY=

# Banco de imagens (opcional). Sem chave nenhuma, as imagens do Sistema PROMPT
# são geradas do zero — que continua sendo o caminho padrão. Com chave, a
# geração parte de uma foto real e a transforma, o que produz cena crível em
# conceito ancorado em lugar.
#
# O Pexels é tentado primeiro: a licença dele não exige atribuição, então a
# maioria das imagens não gera obrigação nenhuma.
PEXELS_API_KEY=

# Unsplash — a *Access Key* da aplicação, usada como `Client-ID`. A *Secret
# Key* NÃO entra aqui: ela serve ao OAuth de agir em nome de um usuário, que
# não fazemos, e guardá-la em produção só aumenta a superfície.
#
# As API Guidelines do Unsplash exigem crédito ao fotógrafo com link de volta
# ao perfil. O post continua sem crédito; o crédito sai na página de entrega
# do material (/ultraprompts/<keyword>/material).
UNSPLASH_ACCESS_KEY=

# Nome da aplicação registrada no Unsplash. Vai no `utm_source` dos links de
# volta, que é como eles atribuem o tráfego à app. Padrão: desbuguei-ia.
UNSPLASH_APP_NAME=
OPENAI_MODEL_TRIAGE=gpt-4o-mini
OPENAI_MODEL_EDITOR=gpt-4o

# Redação Automatizada & Automação Diária
DRY_RUN=false
NEWSLETTER_AUTO_SEND=true
# OBRIGATÓRIA para /api/cron/newsroom. Enviar como cabeçalho:
#   Authorization: Bearer <valor>
# O segredo não é mais aceito na query string.
CRON_SECRET=

# Instagram / Meta Graph API
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# App da Meta — usados só pelo cron /api/cron/refresh-instagram-token pra
# renovar o token de longa duração automaticamente (fb_exchange_token). Sem
# eles o cron ainda avisa quando o token está perto de expirar, mas não renova.
META_APP_ID=
META_APP_SECRET=

# Reels (28/10/2026): busca dos vídeos curtos no YouTube (Data API v3). Sem a
# chave a descoberta segue só com o Instagram.
YOUTUBE_API_KEY=

# Listmonk Newsletter
LISTMONK_URL=
LISTMONK_FORM_LIST_UUID=7c3535ab-988f-4c98-88c0-b73be3b9a90b
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
LISTMONK_DEFAULT_LIST_ID=

# Anti-spam no formulário público — Cloudflare Turnstile ou alternativa similar
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=casaloti.ia.br,www.casaloti.ia.br

# Sistema PROMPT — Fase 1 (etapas 7-9b). Fork mínimo do OpenReply (D1 em
# docs/sistema-prompt-arquitetura.md): rota aditiva POST /api/service/automations
# protegida por este token estático. A rota ainda não existe do lado do
# OpenReply — publicar campanha falha até o fork ser implementado lá.
OPENREPLY_SERVICE_BASE_URL=https://openreply.casaloti.ia.br
PROMPT_SYSTEM_API_TOKEN=

# Observabilidade (Tier 0) — todas OPCIONAIS. Sem elas, o sistema roda igual,
# só não alerta.
#
# Telegram: crie um bot com o @BotFather, mande uma mensagem pra ele, e pegue o
# chat id em https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
#
# healthchecks.io: crie 3 checks (redação ~06:10, tutorial, token do IG ~08:10)
# e cole aqui as URLs de ping. Se o cron não pingar até o horário, o
# healthchecks te avisa.
HEALTHCHECK_NEWSROOM_URL=
HEALTHCHECK_TUTORIAL_URL=
HEALTHCHECK_INSTAGRAM_URL=
#
# IndexNow (06/10/2026), OPCIONAL: avisa Bing e Yandex (e pelo Bing a busca do
# ChatGPT e do Copilot) quando uma matéria é publicada, muda ou sai. Sem ela,
# nada é avisado e o resto segue igual. Só letra e número, de 8 a 128; gere com
#   openssl rand -hex 32
# O site serve a chave em /<chave>.txt sozinho; não há arquivo a criar.
INDEXNOW_KEY=
